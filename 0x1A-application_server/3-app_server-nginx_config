# configure Nginx to serve page from the route /airbnb-onepage/number_odd_or_even/
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 34.204.95.54;

    # custom header
    add_header X-Served-By 520704-web-01;

    # Proxy configuration for the /airbnb-onepage route
    location /airbnb-onepage/ {
        proxy_pass http://127.0.0.1:5000;
        rewrite ^/airbnb-onepage/(.*)$ /airbnb-onepage/$1 break;
    }

    # Proxy configuration for the /airbnb-dynamic/number_odd_or_even route
    location ~ /airbnb-dynamic/number_odd_or_even/(\d+)$ {
        proxy_pass http://127.0.0.1:5001/number_odd_or_even/$1;
    }

    # 404 error page
    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }
}